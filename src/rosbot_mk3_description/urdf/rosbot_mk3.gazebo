<?xml version="1.0" ?>
<robot name="rosbot_mk3" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<xacro:property name="body_color" value="Gazebo/Silver" />

<gazebo reference="base_link">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
  <gravity>true</gravity>

  <sensor name="imu_sensor" type = "imu">
    <always_on>true</always_on>
    <update_rate>100</update_rate>
    <topic>imu</topic>
    <gz_frame_id>base_link</gz_frame_id>
    <visualize>true</visualize>
  </sensor>

</gazebo>

<gazebo reference="right_wheel_1">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="left_wheel_1">
  <material>${body_color}</material>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="lidar_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="camera_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>


<gazebo>
  <plugin filename = "gz-sim-sensors-system" name="gz::sim::systems::Sensors"> 
    <render_engine>ogre2</render_engine>
  </plugin>
  <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
  </plugin>

  <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
    <topic>/joint_states</topic>
  </plugin>
</gazebo>


<gazebo reference="lidar_1">
  <sensor name = 'gpu_lidar' type = 'gpu_lidar'>
    <pose>-5.197880548084268e-18 0.0 0.009999999999999981 0 0 0</pose>
    <topic>scan</topic>
    <gz_frame_id>lidar_1</gz_frame_id>
    <update_rate>1</update_rate>
    <lidar>
      <scan>
        <horizontal>
          <samples>640</samples>
          <resolution>1</resolution>
          <min_angle>-1.396263</min_angle>
          <max_angle>1.396263</max_angle>
        </horizontal>
        <vertical>
          <samples>1</samples>
          <resolution>1</resolution>
          <min_angle>0.0</min_angle>
          <max_angle>0.0</max_angle>
        </vertical>
      </scan>
      <range>
        <min>0.08</min>
        <max>10.0</max>
        <resolution>0.01</resolution>
      </range>
    </lidar>
    <visualize>true</visualize>
  </sensor>
</gazebo>



<gazebo reference="camera_1"> 
  <sensor name = "front_camera" type = "camera">
    <pose>0.095 0 0.09 0 0 0</pose>
    <always_on>true</always_on>
    <update_rate>30</update_rate>
    <topic>camera/front/image</topic>
    <gz_frame_id>camera_1</gz_frame_id>
    <camera>
      <horizontal_fov>1.047</horizontal_fov>
      <image>
        <width>800</width>
        <height>600</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.1</near>
        <far>10</far>
      </clip>
    </camera>
    <visualize>true</visualize>
  </sensor>
</gazebo>


<!--
This block is dedicated to diff_driver plugin which is replaced by custom ros2_control controller
<gazebo>
  <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
    <right_joint>right_wheel_joint</right_joint>
    <left_joint>left_wheel_joint</left_joint>

    <wheel_separation>0.2</wheel_separation>
    <wheel_radius>0.05</wheel_radius>

    <odom_publish_frequency>10</odom_publish_frequency>

    <topic>cmd_vel</topic>

    <odom_topic>odom</odom_topic>
    <frame_id>odom</frame_id>
    <child_frame_id>base_link</child_frame_id>

    <tf_topic>tf</tf_topic>

  </plugin>
</gazebo>
-->
<!-- Importing gz_ros2_control package to interface with ros2_control freamwork -->
<gazebo>
    <plugin filename = "gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find rosbot_mk3_description)/config/controller_manager.yaml</parameters>
    </plugin>
</gazebo>


</robot>
