<?xml version="1.0" ?>
<robot name="oppressor_mk3" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find oppressor_mk3_description)/urdf/materials.xacro" />
<xacro:include filename="$(find oppressor_mk3_description)/urdf/oppressor_mk3.ros2control" />
<xacro:include filename="$(find oppressor_mk3_description)/urdf/oppressor_mk3.gazebo" />
<link name="base_link">
  <inertial>
    <origin xyz="0.002219590589662816 0.0 0.05335026912928722" rpy="0 0 0"/>
    <mass value="29.602080809877986"/>
    <inertia ixx="0.102452" iyy="0.301272" izz="0.383127" ixy="-0.0" iyz="0.0" ixz="-0.002408"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find oppressor_mk3_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find oppressor_mk3_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

