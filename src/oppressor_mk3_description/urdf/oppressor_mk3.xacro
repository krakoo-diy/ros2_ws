    <origin xyz="-3.497202527569243e-15 0.017432802389248395 6.938893903907228e-18" rpy="0 0 0"/>
    <mass value="0.1834267958183613"/>
    <inertia ixx="0.000124" iyy="0.000228" izz="0.000124" ixy="-0.0" iyz="0.0" ixz="0.0"/>
