    <origin xyz="0.00250000000000003 2.8271597168564585e-18 0.0" rpy="0 0 0"/>
    <mass value="0.01233075116533994"/>
    <inertia ixx="1e-06" iyy="0.0" izz="0.0" ixy="-0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
