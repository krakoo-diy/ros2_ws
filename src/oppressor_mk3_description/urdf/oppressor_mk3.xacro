<link name="lidar_1">
  <inertial>
    <origin xyz="-8.041698750169483e-18 -4.0208493750847415e-18 0.012500000000000011" rpy="0 0 0"/>
    <mass value="0.5548838024402972"/>
    <inertia ixx="0.000154" iyy="0.000154" izz="0.00025" ixy="-0.0" iyz="-0.0" ixz="0.0"/>
